            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Candidate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Candidate created successfully"
          }
        }
      }
    },

    "/api/candidates/{id}": {
      "get": {
        "tags": [
          "Candidates"
        ],
        "summary": "Get Candidate By ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate details"
          }
        }
      },

      "put": {
        "tags": [
          "Candidates"
        ],
        "summary": "Update Candidate",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
